{
  "name": "infra",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Nomad Lens",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint bin lib --max-warnings=0",
    "lint:strict": "eslint bin lib --max-warnings=0",
    "test": "vitest run",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval never",
    "diff": "cdk diff",
    "destroy": "cdk destroy"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "aws-cdk": "^2.1128.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.258.0",
    "constructs": "^10.6.0"
  }
}
